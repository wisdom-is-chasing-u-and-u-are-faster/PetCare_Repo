# Database Configuration
DATABASE_URL=sqlite:///./banking.db
DATABASE_FILE=banking.db
SQLITE_DB_PATH=banking.db

# Server & Application Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
APP_URL=http://localhost:8000
AGENT_VERSION=1.0.0

# Security & Session
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloud & Vertex AI Configuration (Optional)
PROJECT_ID=persistent-genai
GOOGLE_CLOUD_PROJECT=persistent-genai
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Jira & CI/CD Integration
JIRA_MCP_URL=http://localhost:8080/jira
JIRA_TOKEN=mock_jira_token
DEFAULT_PR_REVIEWERS=lead-reviewer
